# ============================================
# Agentic Data Analyst Backend - Environment Variables
# ============================================
# IMPORTANT: Copy this file to .env and fill in your actual values
# Command: cp .env.example .env

# ============================================
# API Key
# ============================================
REACT_APP_FUNNEL_API_KEY=your_api_key_here

# ============================================
# Database Configuration (Neon PostgreSQL)
# ============================================
# Shared database - same credentials as Funnel Dashboard

# Neon PostgreSQL Host
CENTRAL_DB_HOST=your_neon_host.neon.tech

# Database Port (default: 5432)
CENTRAL_DB_PORT=5432

# Database Name
CENTRAL_DB_NAME=funnel_central_db

# Database User
CENTRAL_DB_USER=your_db_user

# Database Password
CENTRAL_DB_PASSWORD=your_db_password

# SSL Mode (required for Neon)
CENTRAL_DB_SSL=true

# ============================================
# PostgreSQL Variables (Python Backend)
# ============================================
# Same as above, but with POSTGRES_ prefix for psycopg2

POSTGRES_HOST=your_neon_host.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=funnel_central_db
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password

# ============================================
# Notes
# ============================================
# 1. Never commit .env to git
# 2. SSL is required for Neon PostgreSQL
# 3. All funnels share the same database
# 4. Funnel ID for this site: "agentic-data-analyst"
