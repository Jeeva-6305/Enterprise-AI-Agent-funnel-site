# ============================================
# Agentic Data Analyst Funnel - Environment Variables
# ============================================
# IMPORTANT: Copy this file to .env and fill in your actual values
# Command: cp .env.example .env

# ============================================
# Frontend (Vite/React)
# ============================================
# Note: Vite requires VITE_ prefix for environment variables

# API Key for funnel authentication
VITE_FUNNEL_API_KEY=your_api_key_here

# Backend API URL (local development)
VITE_BACKEND_URL=http://localhost:9075

# ============================================
# Shared Database Credentials (Backend .env)
# ============================================
# Neon PostgreSQL Database (shared across all funnels)
# These should be set in backend/.env

# CENTRAL_DB_HOST=your_neon_host.neon.tech
# CENTRAL_DB_PORT=5432
# CENTRAL_DB_NAME=funnel_central_db
# CENTRAL_DB_USER=your_db_user
# CENTRAL_DB_PASSWORD=your_db_password
# CENTRAL_DB_SSL=true

# ============================================
# Notes
# ============================================
# 1. Never commit .env files to git (already in .gitignore)
# 2. Backend environment variables go in backend/.env
# 3. Frontend variables MUST start with VITE_ prefix
# 4. All funnels share the same Neon PostgreSQL database
